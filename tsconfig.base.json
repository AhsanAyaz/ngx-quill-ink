{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@codewithahsan/quill-ink-core": [
        "./packages/quill-ink-core/src/index.ts"
      ],
      "@codewithahsan/ngx-quill-ink": ["./packages/ngx-quill-ink/src/index.ts"],
      "@codewithahsan/quill-ink-fonts": [
        "./packages/quill-ink-fonts/src/index.ts"
      ],
      "@codewithahsan/quill-ink-fonts/caveat": [
        "./packages/quill-ink-fonts/src/lib/caveat.ts"
      ],
      "@codewithahsan/quill-ink-fonts/dancing-script": [
        "./packages/quill-ink-fonts/src/lib/dancing-script.ts"
      ],
      "@codewithahsan/quill-ink-fonts/shadows-into-light": [
        "./packages/quill-ink-fonts/src/lib/shadows-into-light.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
