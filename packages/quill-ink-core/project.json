{
  "name": "quill-ink-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/quill-ink-core/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": [
        "dist/{projectRoot}"
      ],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [
    "scope:core"
  ],
  "targets": {
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "build-worker": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/tools/scripts/build-worker.mjs",
        "{projectRoot}/src/lib/worker/skeleton-worker.entry.ts",
        "{projectRoot}/src/lib/pipeline/**/*.ts"
      ],
      "outputs": [
        "{projectRoot}/src/lib/worker/worker-code.generated.ts"
      ],
      "options": {
        "command": "node tools/scripts/build-worker.mjs"
      }
    },
    "build": {
      "dependsOn": [
        "^build",
        "build-worker"
      ]
    },
    "vite:test": {
      "dependsOn": [
        "build-worker"
      ]
    },
    "lint": {
      "dependsOn": [
        "build-worker"
      ]
    }
  }
}
