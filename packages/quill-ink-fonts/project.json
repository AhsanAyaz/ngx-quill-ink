{
  "name": "quill-ink-fonts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/quill-ink-fonts/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": [
        "dist/{projectRoot}"
      ],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [
    "scope:fonts"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/packages/quill-ink-fonts",
        "main": "packages/quill-ink-fonts/src/index.ts",
        "tsConfig": "packages/quill-ink-fonts/tsconfig.lib.json",
        "assets": [
          "packages/quill-ink-fonts/*.md",
          {
            "input": "packages/quill-ink-fonts/src/packs",
            "glob": "**/*-OFL.txt",
            "output": "./src/packs"
          },
          "packages/quill-ink-fonts/LICENSE"
        ]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx tools/font-packs/generate.ts --font=all"
      }
    }
  }
}
